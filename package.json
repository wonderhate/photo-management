{
  "name": "photo-management",
  "version": "2.5.1",
  "private": true,
  "description": "Local-first Windows photo management",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1",
    "build": "npm run build --prefix frontend",
    "test": ".venv\\Scripts\\python.exe -m pytest backend/tests -q",
    "test:frontend": "node --experimental-strip-types --test frontend/tests/*.test.*",
    "test:browser": "npx --prefix frontend playwright test --config frontend/playwright.config.ts",
    "test:http": ".venv\\Scripts\\python.exe -m backend.verify_live"
  }
}
